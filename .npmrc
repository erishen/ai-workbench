; CRA(react-scripts) 在 pnpm 严格 node_modules 下会因非严格 require 报模块找不到
; 用 shamefully-hoist 把依赖提升到顶层，行为对齐 npm，保证 react-scripts 正常
shamefully-hoist=true
; 自动安装 peerDependencies（pnpm v8+ 默认已 true，显式声明更稳）
auto-install-peers=true
; 改用 npmmirror 源（沙箱连 npmjs.org 不稳定，常 ECONNRESET）
registry=https://registry.npmmirror.com/
; Electron 二进制也走 npmmirror（避免 GitHub 慢/被墙）
ELECTRON_MIRROR=https://registry.npmmirror.com/-/binary/electron/
