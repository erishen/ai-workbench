{
  "name": "ai-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "本地桌面 AI 工作台：可配置外部大模型，提供页面翻译等 AI 能力模块。",
  "author": "erishen",
  "main": "electron.js",
  "homepage": "./",
  "build": {
    "extends": null,
    "appId": "com.erishen.agentworkflow",
    "productName": "Agent Workflow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron.js",
      "preload.js",
      "main/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "electronDownload": {
      "mirror": "https://registry.npmmirror.com/-/binary/electron/v"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "dmg": {
      "title": "Agent Workflow"
    }
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "dotenv": "^17.4.2",
    "node-html-parser": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "undici": "^6.28.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "dev": "concurrently -k -n WEB,ELECTRON \"cross-env BROWSER=none PORT=5180 react-scripts start\" \"wait-on tcp:5180 && cross-env ELECTRON_DEV_PORT=5180 electron .\"",
    "dist": "electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^3.0.1",
    "electron-reload": "2.0.0-alpha.1",
    "wait-on": "^8.0.3"
  }
}
